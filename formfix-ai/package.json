{
  "name": "formfix-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run build && npm start",
    "start": "node dist/apps/api/src/main.js",
    "worker": "node dist/apps/api/src/jobs/main.js",
    "build": "tsc --noEmit false --outDir dist && node scripts/copy-assets.mjs",
    "test": "vitest run --configLoader native",
    "schemas": "node dist/scripts/schemas.js",
    "smoke": "node dist/scripts/smoke.js",
    "test:e2e": "node dist/scripts/local-e2e.js",
    "evaluate": "node dist/scripts/evaluate.js"
  },
  "dependencies": {
    "@google/genai": "2.23.0",
    "cookie-parser": "1.4.7",
    "dotenv": "16.6.1",
    "express": "5.1.0",
    "helmet": "8.1.0",
    "mongodb": "6.20.0",
    "multer": "2.4.0",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.24.6"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.5",
    "@types/multer": "2.0.0",
    "@types/node": "22.18.6",
    "@types/supertest": "6.0.3",
    "mongodb-memory-server": "10.2.1",
    "pdfjs-dist": "6.3.289",
    "supertest": "7.1.4",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
