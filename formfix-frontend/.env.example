# Which backend answers requests.
#   demo — a deterministic fixture adapter runs in a service worker.
#          Every screen shows "Demo data". No network, no AI provider.
#   live — every request goes to the real backend. Fixtures are never
#          loaded, so a failure shows as a failure.
VITE_APP_MODE=live

# Live mode only. The dev server proxies /api here, so the browser makes a
# same-origin credentialed request and no provider key is ever in the bundle.
API_PROXY_TARGET=http://127.0.0.1:8080
